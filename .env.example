# ──────────────────────────────────────────────────────────
#  The Wheezy League  ·  Frontend Environment Variables
#
#  LOCAL DEV:  Copy to .env.local  →  npm run dev
#  VERCEL:     Set in Vercel dashboard → Project → Settings
#              → Environment Variables
#
#  Never commit .env.local to git.
# ──────────────────────────────────────────────────────────

# ── Auth0 (required) ──────────────────────────────────────
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your_spa_client_id
VITE_AUTH0_AUDIENCE=https://api.wheezyleague.run

# ── Data mode ─────────────────────────────────────────────
# "demo"  → mock data, no backend needed  (use this locally)
# "real"  → calls the Express API         (use this on Vercel)
VITE_DATA_MODE=demo

# ── Backend API URL ───────────────────────────────────────
# Local dev:  http://localhost:4000/api  (separate backend process)
# Vercel:     /api                       (same domain — no CORS needed)
VITE_API_BASE_URL=http://localhost:4000/api

# ── Optional integrations ─────────────────────────────────
