# ─────────────────────────────────────────────────────────
#  The Wheezy League  ·  Frontend Environment Variables
#  Copy to .env.local for local dev. Set in Vercel dashboard
#  under Project → Settings → Environment Variables for prod.
# ─────────────────────────────────────────────────────────

# Auth0 (required)
VITE_AUTH0_DOMAIN=your-tenant.auth0.com
VITE_AUTH0_CLIENT_ID=your_spa_client_id
VITE_AUTH0_AUDIENCE=https://api.wheezyleague.run

# Data mode
# "demo"  — fully offline, uses mock data (default for local dev)
# "real"  — calls your deployed backend API
VITE_DATA_MODE=demo

# Backend API URL (only needed when VITE_DATA_MODE=real)
# Local: http://localhost:4000/api
# Prod:  https://your-backend.railway.app/api
VITE_API_BASE_URL=http://localhost:4000/api

# Third-party integrations (optional)
VITE_STRAVA_CLIENT_ID=
VITE_MAPMYRUN_CLIENT_ID=
