# ─────────────────────────────────────────────────────────
#  The Wheezy League  ·  Backend Environment Variables
#  Copy to .env for local dev. Set in Railway/Render/Fly
#  dashboard for production. Never commit .env to git.
# ─────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Auth0 (required)
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.wheezyleague.run

# Database — Supabase (PostgreSQL) recommended for production
# Get from: Supabase Dashboard → Project → Settings → Database → Connection String
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# Strava (optional)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3000/strava/callback

# MapMyRun / Under Armour (optional)
MAPMYRUN_CLIENT_ID=
MAPMYRUN_CLIENT_SECRET=
MAPMYRUN_REDIRECT_URI=http://localhost:3000/mapmyrun/callback
