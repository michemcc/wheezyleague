# ──────────────────────────────────────────────────────────
#  The Wheezy League  ·  Backend Environment Variables
#
#  LOCAL DEV:  Copy to backend/.env  →  npm run dev
#  VERCEL:     Set in Vercel dashboard → Project → Settings
#              → Environment Variables  (same project as frontend)
#
#  Never commit .env to git.
# ──────────────────────────────────────────────────────────

# ── Runtime ───────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── CORS (local dev only) ─────────────────────────────────
# On Vercel, frontend and API share the same domain, so CORS
# is not needed. Only required for local dev or external calls.
FRONTEND_URL=http://localhost:3000

# ── Auth0 (required) ──────────────────────────────────────
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://api.wheezyleague.run

# ── Database — Supabase ───────────────────────────────────
# Required for production. In-memory store used when unset.
# Get from: Supabase → Project → Settings → API
SUPABASE_URL=https://[ref].supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
